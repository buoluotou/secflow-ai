# =====================================================================
# SecFlow AI — environment configuration template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# =====================================================================

# --- General ---
APP_ENV=development
APP_NAME=SecFlow AI
SECRET_KEY=CHANGE_ME
API_PORT=8000

# --- PostgreSQL ---
POSTGRES_DB=secflow
POSTGRES_USER=secflow
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Wazuh ---
WAZUH_URL=
WAZUH_USERNAME=
WAZUH_PASSWORD=
WAZUH_VERIFY_SSL=false
# Wazuh alerts pulled since this many seconds on first sync (0 = all)
WAZUH_SYNC_INITIAL_LOOKBACK=3600

# --- MISP ---
MISP_URL=
MISP_API_KEY=
MISP_VERIFY_SSL=false
MISP_ORG=SecFlow

# --- Nuclei ---
# mode: docker (docker run projectdiscovery/nuclei) | binary (local nuclei binary)
#       | mock (offline demo mode — synthesized findings, no image required)
NUCLEI_MODE=docker
NUCLEI_IMAGE=projectdiscovery/nuclei:latest
NUCLEI_BIN=nuclei
NUCLEI_CONCURRENCY=10
NUCLEI_TEMPLATE_DIR=

# --- LLM (OpenAI-compatible or Ollama; "mock" = deterministic offline mode) ---
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=120
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# --- Storage ---
DATA_DIR=/data
LOG_DIR=/logs
REPORT_DIR=/reports
OBJECT_STORAGE_URL=

# --- Scheduler ---
WAZUH_SYNC_INTERVAL_SECONDS=300
MISP_ENRICH_INTERVAL_SECONDS=600

# --- Frontend ---
FRONTEND_PORT=80
VITE_API_BASE=/api
